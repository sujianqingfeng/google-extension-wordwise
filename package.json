{
	"name": "google-extension-wordwise",
	"version": "1.1.9",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt -p 3002",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"pack": "web-ext build --source-dir output/chrome-mv3",
		"test": "vitest",
		"test:e2e": "node e2e/run.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.102.3",
		"@webext-core/messaging": "^4.0.0",
		"@webext-core/proxy-service": "^3.0.2",
		"lucide-react": "^1.34.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.3",
		"react-markdown": "^10.1.0",
		"remark-breaks": "^4.0.0"
	},
	"devDependencies": {
		"@types/chrome": "^0.2.7",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"autoprefixer": "^10.5.4",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"postcss": "^8.5.26",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"web-ext": "^10.6.0",
		"wxt": "^0.20.27"
	},
	"packageManager": "pnpm@10.33.0"
}
